{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geomasklab:components:1.0",
  "title": "GeoMaskLab candidate component inspection",
  "description": "Shape validation complements mandatory pixel-level source-bound replay. Components describe clipped mask regions, not semantic objects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "software_version", "source_bundle_sha256", "source_image_sha256", "source_result_mask_sha256", "source_run_id", "source_version", "image_size", "source_task", "analysis_config", "connectivity", "component_id_order", "bbox_convention", "centroid_convention", "boundary_rules", "options", "component_count", "foreground_pixels", "selected_component_count", "selected_foreground_pixels", "excluded_component_count", "components", "source_mask_modified", "inference_performed", "semantic_objects_verified", "interpretation"],
  "properties": {
    "schema": {"const": "geomasklab-component-inspection/1.0"},
    "software_version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
    "source_bundle_sha256": {"$ref": "#/$defs/hash"},
    "source_image_sha256": {"$ref": "#/$defs/hash"},
    "source_result_mask_sha256": {"$ref": "#/$defs/hash"},
    "source_run_id": {"type": "string", "pattern": "^[a-f0-9]{12}$"},
    "source_version": {"type": "integer", "minimum": 1},
    "image_size": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
    "source_task": {"type": "object"},
    "analysis_config": {"type": ["object", "null"]},
    "connectivity": {"const": 8},
    "component_id_order": {"type": "string", "minLength": 1},
    "bbox_convention": {"type": "string", "minLength": 1},
    "centroid_convention": {"type": "string", "minLength": 1},
    "boundary_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["neighborhood", "image", "roi", "invalid", "overlap"],
      "properties": {
        "neighborhood": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1},
        "roi": {"type": "string", "minLength": 1},
        "invalid": {"type": "string", "minLength": 1},
        "overlap": {"type": "string", "minLength": 1}
      }
    },
    "options": {
      "type": "object", "additionalProperties": false,
      "required": ["min_area_pixels", "boundary_filter"],
      "properties": {
        "min_area_pixels": {"type": "integer", "minimum": 1},
        "boundary_filter": {"enum": ["all", "touching", "interior"]}
      }
    },
    "component_count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "foreground_pixels": {"type": "integer", "minimum": 0},
    "selected_component_count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "selected_foreground_pixels": {"type": "integer", "minimum": 0},
    "excluded_component_count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}, "maxItems": 100000},
    "source_mask_modified": {"const": false},
    "inference_performed": {"const": false},
    "semantic_objects_verified": {"const": false},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "area_pixels", "bbox", "centroid", "touches_image_boundary", "touches_roi_boundary", "touches_invalid_boundary", "selected", "exclusion_reasons"],
      "properties": {
        "component_id": {"type": "integer", "minimum": 1, "maximum": 100000},
        "area_pixels": {"type": "integer", "minimum": 1},
        "bbox": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 4, "maxItems": 4},
        "centroid": {
          "type": "object", "additionalProperties": false, "required": ["x", "y"],
          "properties": {"x": {"type": "number", "minimum": 0.5}, "y": {"type": "number", "minimum": 0.5}}
        },
        "touches_image_boundary": {"type": "boolean"},
        "touches_roi_boundary": {"type": "boolean"},
        "touches_invalid_boundary": {"type": "boolean"},
        "selected": {"type": "boolean"},
        "exclusion_reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["below_minimum_area", "no_boundary_contact", "boundary_contact"]}}
      },
      "allOf": [{"if": {"properties": {"selected": {"const": true}}}, "then": {"properties": {"exclusion_reasons": {"maxItems": 0}}}, "else": {"properties": {"exclusion_reasons": {"minItems": 1}}}}]
    }
  }
}
