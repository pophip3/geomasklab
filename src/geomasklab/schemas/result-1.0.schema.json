{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geomasklab:evidence:result:1.0",
  "title": "GeoMaskLab result record, version 1.0",
  "type": "object",
  "required": [
    "id",
    "session_id",
    "version",
    "task",
    "mode",
    "provenance",
    "metrics",
    "full_mask_sha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{12}$"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "software_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "needs_review"
      ]
    },
    "mode": {
      "enum": [
        "demo",
        "live",
        "external"
      ]
    },
    "inference_performed": {
      "type": "boolean"
    },
    "task": {
      "type": "object",
      "required": [
        "target",
        "side"
      ],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "side": {
          "enum": [
            "all",
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "roi": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "xyxy": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "source": {
              "enum": [
                "drawn",
                "imported"
              ]
            },
            "image_size": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "required": [
            "xyxy",
            "source",
            "image_size"
          ]
        },
        "invert": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "image_sha256"
      ],
      "properties": {
        "image_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "planner": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "perception": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "$ref": "urn:geomasklab:evidence:statistics:1.0"
    },
    "full_mask_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "external_mask": {
      "type": "object",
      "required": [
        "source",
        "upload_sha256",
        "origin_authenticated",
        "alignment_user_assertion"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "upload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "origin_authenticated": {
          "const": false
        },
        "alignment_user_assertion": {
          "const": true
        }
      }
    },
    "analysis_config": {
      "title": "GeoMaskLab realized analysis configuration",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "geomasklab-analysis-config/1.0"
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "image_size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "coordinate_system": {
          "const": "normalized_image_pixels"
        },
        "scope": {
          "enum": [
            "all",
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "roi": {
          "type": [
            "object",
            "null"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "invert": {
          "type": "boolean"
        },
        "connectivity": {
          "const": 8
        },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "source",
            "upload_sha256",
            "alignment_user_assertion",
            "origin_authenticated"
          ],
          "properties": {
            "policy": {
              "enum": [
                "explicit_binary_mask",
                "all_pixels_declared_valid"
              ]
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 1000
            },
            "upload_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "alignment_user_assertion": {
              "const": true
            },
            "origin_authenticated": {
              "const": false
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "policy": {
                    "const": "explicit_binary_mask"
                  }
                }
              },
              "then": {
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "upload_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "else": {
                "properties": {
                  "source": {
                    "type": "null"
                  },
                  "upload_sha256": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "schema",
        "image_sha256",
        "image_size",
        "coordinate_system",
        "scope",
        "roi",
        "target",
        "invert",
        "connectivity",
        "validity"
      ]
    }
  },
  "description": "Result shape for completed segmentation evidence. Source identity and scientific measurements must also pass image replay. Legacy schema names are retained for compatibility."
}
