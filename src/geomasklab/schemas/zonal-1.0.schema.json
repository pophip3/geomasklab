{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pophip3.github.io/geomasklab/schemas/zonal-1.0.schema.json",
  "title": "GeoMaskLab zonal assessment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "software_version",
    "source_bundle_sha256",
    "geometry_sha256",
    "coordinates",
    "source_geotiff_sha256",
    "grid",
    "source_task",
    "inference_performed",
    "semantic_accuracy_verified",
    "rasterization",
    "zone_aggregation",
    "edge_transformation",
    "zones"
  ],
  "properties": {
    "schema": {
      "const": "geomasklab-zonal-assessment/1.0"
    },
    "software_version": {
      "type": "string",
      "minLength": 1
    },
    "source_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "geometry_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coordinates": {
      "enum": [
        "pixel",
        "wgs84"
      ]
    },
    "source_geotiff_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "grid": {
      "type": [
        "object",
        "null"
      ]
    },
    "source_task": {
      "type": "object"
    },
    "inference_performed": {
      "const": false
    },
    "semantic_accuracy_verified": {
      "const": false
    },
    "rasterization": {
      "type": "string"
    },
    "zone_aggregation": {
      "type": "string"
    },
    "edge_transformation": {
      "type": "string"
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "zone_id",
          "foreground_pixels",
          "selected_region_pixels",
          "whole_image_pixels",
          "coverage_of_region",
          "coverage_of_image"
        ],
        "properties": {
          "zone_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          },
          "foreground_pixels": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64000000
          },
          "selected_region_pixels": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64000000
          },
          "whole_image_pixels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64000000
          },
          "coverage_of_region": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "coverage_of_image": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "foreground_area_m2": {
            "type": "number",
            "minimum": 0
          },
          "selected_region_area_m2": {
            "type": "number",
            "minimum": 0
          },
          "whole_image_area_m2": {
            "type": "number",
            "minimum": 0
          }
        },
        "dependentRequired": {
          "foreground_area_m2": [
            "selected_region_area_m2",
            "whole_image_area_m2"
          ]
        }
      }
    }
  }
}
