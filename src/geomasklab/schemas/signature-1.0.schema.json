{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pophip3.github.io/geomasklab/schemas/signature-1.0.schema.json",
  "title": "GeoMaskLab detached signature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "software_version",
    "algorithm",
    "artifact_sha256",
    "artifact_bytes",
    "public_key_sha256",
    "signature_base64"
  ],
  "properties": {
    "schema": {
      "const": "geomasklab-detached-signature/1.0"
    },
    "software_version": {
      "type": "string",
      "minLength": 1
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "public_key_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  }
}
