# Copy to .env in the project root. Shell GEO_ variables take precedence.
# Examples only: replace with teammate-verified addresses and model ID.
GEO_AGENT_BASE_URL=http://127.0.0.1:8000/v1
GEO_AGENT_MODEL=RemoteAgent
GEO_AGENT_API_KEY=
# Optional for disk offload: longer HTTP timeout and shorter generated answers.
# Defaults are 120 seconds and route-specific output limits (512/1024 tokens).
# GEO_AGENT_TIMEOUT_SECONDS=1800
# GEO_AGENT_MAX_TOKENS=128
GEO_REMOTESAM_URL=http://127.0.0.1:6657/predict
GEO_REMOTESAM_REVISION=
# Direct connections to configured model services avoid stale download proxies.
# Use environment only when those services genuinely require an HTTP proxy.
GEO_SERVICE_PROXY_MODE=direct
GEO_PORT=4180
